    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tanstack/react-virtual": "^3.14.22",
    "clsx": "^2.1.1",
    "d3-force-3d": "^3.0.6",
    "d3-hierarchy": "^3.1.2",
    "immutable": "^5.1.9",
    "jetbrains-mono": "^1.0.6",
    "jsep": "^1.6.0",
    "lucide-react": "^1.61.0",
    "maath": "^0.10.8",
    "monaco-editor": "^0.57.0",
    "postprocessing": "~6.39.5",
    "radix-ui": "^1.8.1",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-resizable-panels": "^4.15.0",
